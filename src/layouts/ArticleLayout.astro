---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuickPicks from '../components/QuickPicks.astro';
import ProductCard from '../components/ProductCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleTags from '../components/ArticleTags.astro';
import { getImageUrl, getImageAttributes } from '../utils/image';
import { formatDate } from '../utils/time';
import { buildBreadcrumbs } from '../utils/taxonomy';
import { SITE_CONFIG } from '../config/site';
import type { CollectionEntry } from 'astro:content';

interface ProductItem {
  position: number;
  name: string;
  brand: string;
  model?: string;
  asin?: string;
  image: string;
  imageAlt: string;
  imageSource?: string;
  imageRightsStatus?: string;
  editorialBadge?: string;
  shortDescription: string;
  bestFor: string;
  pros: string[];
  cons: string[];
  priceDisplay?: string;
  priceObservedAt?: string;
  priceVerification?: 'verified' | 'user-observed' | 'unknown';
  availabilityNote?: string;
  availabilityVerification?: 'verified' | 'unknown' | 'out-of-stock';
  affiliateUrl: string;
  researchNote?: string;
}

interface QuickPickItem {
  badge: string;
  name: string;
  asin?: string;
  affiliateUrl: string;
  priceDisplay?: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

interface TagItem {
  name: string;
  slug: string;
}

interface RelatedArticleItem {
  article: CollectionEntry<'articles'>;
  categoryName: string;
  categorySlug: string;
  authorName?: string;
}

interface Props {
  title: string;
  slug: string;
  description: string;
  publishedDate: Date;
  updatedDate?: Date;
  lastVerified: Date;
  readingTime: number;
  author: {
    name: string;
    role?: string;
    bio?: string;
    avatar?: string;
  };
  category: {
    name: string;
    slug: string;
  };
  subcategory?: {
    name: string;
    slug: string;
  };
  tags?: TagItem[];
  heroImage: string;
  heroImageAlt: string;
  quickPicks?: QuickPickItem[];
  products: ProductItem[];
  faq?: FAQItem[];
  affiliateDisclosure?: string;
  relatedArticles?: RelatedArticleItem[];
}

const {
  title,
  slug,
  description,
  publishedDate,
  updatedDate,
  lastVerified,
  readingTime,
  author,
  category,
  subcategory,
  tags = [],
  heroImage,
  heroImageAlt,
  quickPicks = [],
  products = [],
  faq = [],
  affiliateDisclosure,
  relatedArticles = [],
} = Astro.props;

const breadcrumbs = buildBreadcrumbs({
  categoryName: category.name,
  categorySlug: category.slug,
  subcategoryName: subcategory?.name,
  subcategorySlug: subcategory?.slug,
  articleTitle: title,
});

const heroUrl = getImageUrl(heroImage, 'hero');
const heroAttrs = getImageAttributes('hero');
const articleUrl = `${SITE_CONFIG.url}/${slug}/`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={articleUrl}
  image={heroUrl}
  type="article"
  publishedTime={publishedDate.toISOString()}
  modifiedTime={updatedDate?.toISOString() || publishedDate.toISOString()}
  authorName={author.name}
  breadcrumbs={breadcrumbs}
  articleData={{
    title,
    description,
    publishedDate: publishedDate.toISOString(),
    updatedDate: updatedDate?.toISOString(),
    heroImage: heroUrl,
    authorName: author.name,
    url: articleUrl,
    faq: faq && faq.length > 0 ? faq : undefined,
  }}
>
  <article class="article-page-wrapper">
    <div class="container article-container">
      <Breadcrumbs items={breadcrumbs} />

      <!-- Article Top Header -->
      <header class="article-header">
        <div class="category-pills-row">
          <a href={`/category/${category.slug}/`} class="category-pill">{category.name}</a>
          {subcategory && (
            <a href={`/category/${category.slug}/${subcategory.slug}/`} class="subcategory-pill">{subcategory.name}</a>
          )}
        </div>

        <h1 class="article-h1">{title}</h1>
        <p class="article-lead">{description}</p>

        <!-- Author & Editorial Verification Bar -->
        <div class="author-transparency-card">
          <div class="author-info-group">
            <div class="author-meta-lines">
              <span class="author-name-role">Written by <strong>{author.name}</strong></span>
              <div class="article-timestamps">
                <span>Published: {formatDate(publishedDate)}</span>
                <span class="meta-dot">•</span>
                <span class="verified-status">✓ Last Verified: {formatDate(lastVerified)}</span>
                <span class="meta-dot">•</span>
                <span>{readingTime} min read</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Affiliate & Point-in-Time Pricing Disclosure -->
        <div class="editorial-disclosure-banner">
          <div class="disclosure-icon-col">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </div>
          <p class="disclosure-body">
            <strong>Affiliate & Pricing Transparency:</strong> {affiliateDisclosure || SITE_CONFIG.amazonDisclosure}
            Prices, taxes, and product availability on Amazon India fluctuate frequently. Observed prices in this guide are captured at the verified date.
          </p>
        </div>

        <!-- Featured LCP Hero Image -->
        <div class="article-hero-frame">
          <img
            src={heroUrl}
            alt={heroImageAlt || title}
            width={heroAttrs.width}
            height={heroAttrs.height}
            style={heroAttrs.style}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="article-hero-image"
            onerror={`this.onerror=null;this.src='/images/articles/${slug}-hero.jpg';this.addEventListener('error',()=>this.src='/images/brand/placeholder.svg');`}
          />
        </div>
      </header>

      <!-- Main Article Content Body (Centered Editorial Width) -->
      <div class="article-main-body">
        <!-- Quick Picks Summary -->
        {quickPicks && quickPicks.length > 0 && <QuickPicks picks={quickPicks} />}

        <!-- Recommended Products Showcase (Directly below Quick Picks for high shopper utility) -->
        {products && products.length > 0 && (
          <section class="products-section" id="recommended-products" aria-label="Detailed Product Recommendations">
            <div class="section-title-header">
              <h2 class="section-heading">Detailed Product Recommendations</h2>
              <p class="section-subheading">In-depth evaluations, specification summaries, and pros & cons for each option.</p>
            </div>
            <div class="products-list-wrapper">
              {products.map((product) => (
                <ProductCard {...product} />
              ))}
            </div>
          </section>
        )}

        <!-- Markdown Editorial Slot (Comparison Table, Editorial Analysis, How to Choose) -->
        <div class="editorial-prose">
          <slot />
        </div>

        <!-- Selection Methodology Box -->
        <section class="methodology-card" aria-label="Our Selection Methodology">
          <div class="methodology-header">
            <span class="methodology-icon">🛡️</span>
            <h3 class="methodology-title">How We Selected These Recommendations</h3>
          </div>
          <p class="methodology-text">
            Our editorial process prioritizes genuine technical specifications, value for Indian shoppers (INR pricing), warranty and service network support in India, and user feedback analysis.
          </p>
          <ul class="methodology-bullets">
            <li><strong>Value for Money:</strong> Observed INR pricing is weighed against build quality, durability, and features.</li>
            <li><strong>India-Specific Suitability:</strong> Evaluated for local voltage compatibility, climate durability, and authorized brand support.</li>
            <li><strong>Honest Truth-in-Publishing:</strong> We never claim physical hands-on testing unless conducted in our studio.</li>
          </ul>
        </section>

        <!-- FAQ Accordion -->
        {faq && faq.length > 0 && (
          <section class="faq-section-block" aria-label="Frequently Asked Questions">
            <h3 class="faq-main-title">Frequently Asked Questions</h3>
            <div class="faq-accordion-group">
              {faq.map((item) => (
                <details class="faq-accordion-item">
                  <summary class="faq-summary-row">
                    <span class="faq-question-text">{item.question}</span>
                    <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </summary>
                  <div class="faq-answer-content">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- Article Controlled Tags -->
        <ArticleTags tags={tags} />
      </div>

      <!-- Related Articles Section -->
      {relatedArticles && relatedArticles.length > 0 && (
        <section class="related-articles-section" aria-label="Related Buying Guides">
          <div class="section-title-header">
            <h2 class="section-heading">More Guides You Might Like</h2>
            <p class="section-subheading">Handpicked editorial recommendations from the {category.name} department</p>
          </div>
          <div class="related-grid">
            {relatedArticles.map(({ article, categoryName, categorySlug, authorName }) => (
              <ArticleCard
                title={article.data.title}
                slug={article.slug}
                description={article.data.description}
                categoryName={categoryName}
                categorySlug={categorySlug}
                heroImage={article.data.heroImage}
                heroImageAlt={article.data.heroImageAlt}
                publishedDate={article.data.publishedDate}
                readingTime={article.data.readingTime}
                authorName={authorName}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .article-page-wrapper {
    padding: 1.5rem 0 4rem;
  }

  .article-container {
    max-width: 960px;
  }

  /* Header */
  .article-header {
    margin-bottom: 2.5rem;
  }
  .category-pills-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }
  .category-pill {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    border: 1px solid var(--color-primary-border);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  .subcategory-pill {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-slate-700);
    background-color: var(--color-slate-100);
    border: 1px solid var(--color-slate-200);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    text-decoration: none;
  }

  .article-h1 {
    font-size: clamp(1.85rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--color-slate-950);
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0 0 1rem 0;
  }
  .article-lead {
    font-size: 1.15rem;
    color: var(--color-slate-600);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  /* Author Transparency Card */
  .author-transparency-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.25rem;
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-subtle);
  }
  .author-info-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    object-fit: cover;
    background-color: var(--color-slate-100);
    flex-shrink: 0;
  }
  .author-name-role {
    font-size: 0.88rem;
    color: var(--color-slate-800);
    display: block;
    margin-bottom: 0.15rem;
  }
  .author-role-tag {
    color: var(--color-slate-500);
    font-weight: 500;
  }
  .article-timestamps {
    font-size: 0.78rem;
    color: var(--color-slate-500);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .meta-dot {
    color: var(--color-slate-300);
  }
  .verified-status {
    color: var(--color-success);
    font-weight: 700;
  }

  /* Disclosure Banner */
  .editorial-disclosure-banner {
    background-color: #f8fafc;
    border: 1px solid var(--color-slate-200);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.15rem;
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .disclosure-icon-col {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .disclosure-body {
    font-size: 0.82rem;
    color: var(--color-slate-600);
    line-height: 1.5;
    margin: 0;
  }
  .disclosure-body strong {
    color: var(--color-slate-800);
  }

  /* Hero Image Frame */
  .article-hero-frame {
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-slate-100);
    box-shadow: var(--shadow-sm);
  }
  .article-hero-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  /* Main Editorial Content */
  .article-main-body {
    margin-top: 2rem;
  }

  .editorial-prose {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-slate-800);
    margin-bottom: 3rem;
  }
  .editorial-prose :global(h2) {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 800;
    color: var(--color-slate-900);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .editorial-prose :global(h3) {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 700;
    color: var(--color-slate-900);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .editorial-prose :global(p) {
    margin-bottom: 1.25rem;
  }
  .editorial-prose :global(ul), .editorial-prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .editorial-prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .editorial-prose :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    background-color: var(--color-primary-light);
    padding: 1rem 1.25rem;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: 1.5rem 0;
    color: var(--color-slate-800);
    font-style: italic;
  }

  /* Section Title Bars */
  .section-title-header {
    margin-bottom: 1.5rem;
  }
  .section-heading {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 800;
    color: var(--color-slate-900);
    letter-spacing: -0.02em;
    margin: 0 0 0.35rem 0;
  }
  .section-subheading {
    font-size: 0.9rem;
    color: var(--color-slate-500);
    margin: 0;
  }

  /* Methodology Card */
  .methodology-card {
    background: linear-gradient(135deg, #faf8ff 0%, #f5f3ff 100%);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    margin: 3rem 0;
    box-shadow: var(--shadow-subtle);
  }
  .methodology-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
  }
  .methodology-icon {
    font-size: 1.25rem;
  }
  .methodology-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-slate-900);
    margin: 0;
  }
  .methodology-text {
    font-size: 0.92rem;
    color: var(--color-slate-700);
    line-height: 1.6;
    margin: 0 0 1rem 0;
  }
  .methodology-bullets {
    padding-left: 1.25rem;
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-slate-700);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .methodology-bullets strong {
    color: var(--color-slate-900);
  }

  /* FAQ Accordion */
  .faq-section-block {
    margin: 3.5rem 0;
  }
  .faq-main-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-slate-900);
    margin-bottom: 1.25rem;
    letter-spacing: -0.015em;
  }
  .faq-accordion-group {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .faq-accordion-item {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow-subtle);
    transition: border-color 0.15s ease;
  }
  .faq-accordion-item[open] {
    border-color: var(--color-primary-border);
  }
  .faq-summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-slate-900);
    cursor: pointer;
    list-style: none;
    user-select: none;
    gap: 1rem;
  }
  .faq-summary-row::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    color: var(--color-primary);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .faq-accordion-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-answer-content {
    padding-top: 0.85rem;
    font-size: 0.92rem;
    color: var(--color-slate-700);
    line-height: 1.6;
    border-top: 1px solid var(--color-slate-100);
    margin-top: 0.75rem;
  }
  .faq-answer-content p {
    margin: 0;
  }

  /* Author Bio */
  .author-bio-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    margin: 3rem 0;
    box-shadow: var(--shadow-subtle);
  }
  .bio-avatar {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    object-fit: cover;
    flex-shrink: 0;
  }
  .bio-author-name {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-slate-900);
    margin: 0 0 0.35rem 0;
  }
  .bio-author-desc {
    font-size: 0.88rem;
    color: var(--color-slate-600);
    line-height: 1.55;
    margin: 0;
  }

  /* Related Articles Section */
  .related-articles-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-slate-200);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .author-bio-card {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

