---
import { buildAmazonAffiliateUrl, AFFILIATE_LINK_ATTRIBUTES } from '../utils/affiliate';

interface QuickPickItem {
  badge: string;
  name: string;
  asin?: string;
  affiliateUrl: string;
  priceDisplay?: string;
}

interface Props {
  picks: QuickPickItem[];
}

const { picks } = Astro.props;
---

<div class="quick-picks-container">
  <div class="quick-picks-header">
    <div class="header-title-group">
      <span class="icon">⚡</span>
      <h3 class="quick-picks-title">Quick Picks: Top Recommendations at a Glance</h3>
    </div>
    <span class="quick-picks-note">Short on time? Here are our top-rated picks for different needs.</span>
  </div>

  <div class="quick-picks-grid">
    {picks.map((pick, index) => {
      const finalUrl = buildAmazonAffiliateUrl(pick.affiliateUrl || pick.asin || '');
      return (
        <div class="quick-pick-card">
          <span class="pick-badge">{pick.badge}</span>
          <h4 class="pick-name">{pick.name}</h4>
          {pick.priceDisplay && <span class="pick-price">{pick.priceDisplay}</span>}
          <a
            href={finalUrl}
            rel={AFFILIATE_LINK_ATTRIBUTES.rel}
            target={AFFILIATE_LINK_ATTRIBUTES.target}
            class="pick-link"
          >
            Check Price →
          </a>
        </div>
      );
    })}
  </div>
</div>

<style>
  .quick-picks-container {
    background-color: var(--color-white);
    border: 2px solid var(--color-primary-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin: 1.5rem 0 2.5rem;
    box-shadow: var(--shadow-sm);
  }
  .quick-picks-header {
    margin-bottom: 1.25rem;
  }
  .header-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .header-title-group .icon {
    font-size: 1.25rem;
  }
  .quick-picks-title {
    font-size: 1.15rem;
    margin: 0;
    color: var(--color-slate-900);
  }
  .quick-picks-note {
    font-size: 0.85rem;
    color: var(--color-slate-500);
    display: block;
    margin-top: 0.25rem;
  }

  .quick-picks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .quick-pick-card {
    background-color: var(--color-primary-light);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
  }
  .pick-badge {
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }
  .pick-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-slate-900);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
    flex: 1;
  }
  .pick-price {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-slate-700);
    margin-bottom: 0.75rem;
  }
  .pick-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }
  .pick-link:hover {
    text-decoration: underline;
  }
</style>
