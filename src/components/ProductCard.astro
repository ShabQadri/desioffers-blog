---
import { getImageUrl, getImageAttributes } from '../utils/image';
import { buildAmazonAffiliateUrl, AFFILIATE_LINK_ATTRIBUTES } from '../utils/affiliate';

interface Props {
  position: number;
  name: string;
  brand: string;
  model?: string;
  asin?: string;
  image?: string;
  imageAlt?: string;
  imageSource?: string;
  imageRightsStatus?: string;
  editorialBadge?: string;
  shortDescription: string;
  bestFor: string;
  pros: string[];
  cons: string[];
  priceDisplay?: string;
  priceObservedAt?: string;
  priceVerification?: 'verified' | 'user-observed' | 'unknown';
  availabilityNote?: string;
  availabilityVerification?: 'verified' | 'unknown' | 'out-of-stock';
  affiliateUrl: string;
}

const {
  position,
  name,
  brand,
  model,
  asin,
  image,
  imageAlt,
  imageSource = 'none',
  imageRightsStatus,
  editorialBadge,
  shortDescription,
  bestFor,
  pros = [],
  cons = [],
  priceDisplay,
  priceObservedAt,
  priceVerification = 'unknown',
  availabilityNote,
  availabilityVerification,
  affiliateUrl,
} = Astro.props;

const hasImage = Boolean(image && image.trim() !== '' && imageSource !== 'none' && imageRightsStatus !== 'restricted');
const finalAffiliateUrl = buildAmazonAffiliateUrl(affiliateUrl || asin || '');
const imageUrl = hasImage ? getImageUrl(image, 'medium') : '';
const imgAttrs = getImageAttributes('medium');

const hasPrice = Boolean(priceDisplay && priceDisplay.trim() !== '');
const isUserObservedPrice = hasPrice && (priceVerification === 'user-observed' || !priceVerification);
const isVerifiedPrice = hasPrice && priceVerification === 'verified';

let formattedObservedDate = '';
if (priceObservedAt) {
  try {
    const d = new Date(priceObservedAt);
    if (!isNaN(d.getTime())) {
      formattedObservedDate = d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
    }
  } catch {}
}
---

<article class="product-card" id={`product-${position}`} aria-label={`Product #${position}: ${name}`}>
  <!-- 1. Card Top Badge Row -->
  <div class="card-header-bar">
    <div class="header-left-badges">
      <span class="rank-badge" aria-label={`Rank #${position}`}>#{position}</span>
      {editorialBadge && (
        <span class="editorial-badge">{editorialBadge}</span>
      )}
    </div>
    {bestFor && (
      <div class="best-for-tag">
        <span class="best-for-label">Best for:</span>
        <span class="best-for-val">{bestFor}</span>
      </div>
    )}
  </div>

  <!-- 2. Product Name & Brand/Model Subtitle -->
  <div class="product-title-group">
    <h3 class="product-heading">{name}</h3>
    <p class="product-brand-line">
      <span class="brand-name">{brand}</span>
      {model && <span class="model-name">• {model}</span>}
      {asin && <span class="asin-tag">• ASIN: {asin}</span>}
    </p>
  </div>

  <!-- 3. Main Media + Overview Section -->
  <div class={`product-core-grid ${hasImage ? 'has-media' : 'is-imageless'}`}>
    {hasImage && (
      <div class="product-media-panel">
        <img
          src={imageUrl}
          alt={imageAlt || name}
          width={imgAttrs.width}
          height={imgAttrs.height}
          style={imgAttrs.style}
          loading="lazy"
          decoding="async"
          class="product-image"
          onerror="this.onerror=null;this.src='/images/brand/placeholder.svg';"
        />
      </div>
    )}

    <div class="product-editorial-panel">
      <!-- Short Editorial Verdict -->
      {shortDescription && (
        <div class="verdict-container">
          <div class="verdict-badge-row">
            <span class="verdict-pill">Editorial Verdict</span>
          </div>
          <p class="verdict-summary">{shortDescription}</p>
        </div>
      )}

      <!-- Pros & Cons Grid -->
      {(pros.length > 0 || cons.length > 0) && (
        <div class="pros-cons-container">
          {pros.length > 0 && (
            <div class="pc-column pros-column">
              <h4 class="pc-title pros-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Pros</span>
              </h4>
              <ul class="pc-items-list">
                {pros.map((pro) => (
                  <li>{pro}</li>
                ))}
              </ul>
            </div>
          )}

          {cons.length > 0 && (
            <div class="pc-column cons-column">
              <h4 class="pc-title cons-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
                <span>Cons</span>
              </h4>
              <ul class="pc-items-list">
                {cons.map((con) => (
                  <li>{con}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- 4. Price & Amazon CTA Footer Action Strip -->
  <div class="card-footer-strip">
    <div class="price-context-group">
      {hasPrice ? (
        <div class="price-display-row">
          <span class="price-type-label">{isVerifiedPrice ? 'Verified Price' : 'Observed Price'}</span>
          <span class="price-figure">{priceDisplay}</span>
        </div>
      ) : (
        <div class="price-display-row no-price">
          <span class="price-type-label">Amazon India</span>
          <span class="price-unspecified">Check current pricing</span>
        </div>
      )}

      <div class="price-disclosures-block">
        {isUserObservedPrice && (
          <span class="disclosure-compact-text">
            Price observed when updated{formattedObservedDate ? ` (${formattedObservedDate})` : ''}; Amazon pricing & availability fluctuate.
          </span>
        )}
        {isVerifiedPrice && formattedObservedDate && (
          <span class="disclosure-compact-text verified-note">
            ✓ Verified as of {formattedObservedDate}.
          </span>
        )}
        <span class="stock-status-line">{availabilityNote || 'Subject to Amazon India stock availability'}</span>
      </div>
    </div>

    <div class="cta-action-group">
      <a
        href={finalAffiliateUrl}
        rel={AFFILIATE_LINK_ATTRIBUTES.rel}
        target={AFFILIATE_LINK_ATTRIBUTES.target}
        class="btn btn-amazon product-cta-btn"
        aria-label={`Check price for ${name} on Amazon India`}
      >
        <span>Check Price on Amazon</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <span class="affiliate-direct-note">Direct link via Amazon Associate Program</span>
    </div>
  </div>
</article>

<style>
  .product-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    position: relative;
    scroll-margin-top: 5rem;
  }
  .product-card:hover {
    border-color: var(--color-primary-border);
    box-shadow: var(--shadow-md);
  }

  /* 1. Header Badges */
  .card-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .header-left-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .rank-badge {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    letter-spacing: -0.01em;
  }
  .editorial-badge {
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border: 1px solid var(--color-primary-border);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }
  .best-for-tag {
    font-size: 0.8rem;
    color: var(--color-slate-700);
    background-color: var(--color-slate-100);
    border: 1px solid var(--color-slate-200);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }
  .best-for-label {
    font-weight: 700;
    color: var(--color-slate-900);
    margin-right: 0.25rem;
  }
  .best-for-val {
    font-weight: 500;
    color: var(--color-slate-700);
  }

  /* 2. Title & Subtitle */
  .product-title-group {
    margin-bottom: 1.25rem;
  }
  .product-heading {
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 800;
    color: var(--color-slate-900);
    line-height: 1.3;
    margin: 0 0 0.35rem 0;
    letter-spacing: -0.015em;
  }
  .product-brand-line {
    font-size: 0.84rem;
    color: var(--color-slate-500);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .brand-name {
    font-weight: 700;
    color: var(--color-slate-700);
  }
  .asin-tag {
    font-family: monospace;
    font-size: 0.76rem;
    color: var(--color-slate-400);
  }

  /* 3. Core Media + Editorial Grid */
  .product-core-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    align-items: start;
  }
  .product-core-grid.is-imageless {
    grid-template-columns: 1fr;
  }

  .product-media-panel {
    background-color: var(--color-slate-50);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
  }
  .product-image {
    max-width: 100%;
    max-height: 200px;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .product-editorial-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Editorial Verdict Box */
  .verdict-container {
    background: linear-gradient(135deg, #faf8ff 0%, #f5f3ff 100%);
    border: 1px solid var(--color-primary-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
  }
  .verdict-badge-row {
    margin-bottom: 0.4rem;
  }
  .verdict-pill {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }
  .verdict-summary {
    font-size: 0.92rem;
    color: var(--color-slate-800);
    line-height: 1.55;
    margin: 0;
  }

  /* Pros & Cons */
  .pros-cons-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .pc-column {
    border-radius: var(--radius-md);
    padding: 0.9rem 1rem;
  }
  .pros-column {
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
  }
  .cons-column {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
  }
  .pc-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem 0;
  }
  .pros-title { color: #15803d; }
  .cons-title { color: #b91c1c; }

  .pc-items-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .pc-items-list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.82rem;
    color: var(--color-slate-800);
    line-height: 1.45;
  }
  .pros-column .pc-items-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #16a34a;
    font-weight: bold;
  }
  .cons-column .pc-items-list li::before {
    content: "−";
    position: absolute;
    left: 0;
    color: #dc2626;
    font-weight: bold;
    font-size: 1.1rem;
    line-height: 0.9;
  }

  /* 4. Footer Action Strip */
  .card-footer-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-slate-200);
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .price-context-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 420px;
  }
  .price-display-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .price-type-label {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-slate-500);
  }
  .price-figure {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-slate-950);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .price-unspecified {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-slate-700);
  }

  .price-disclosures-block {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .disclosure-compact-text {
    font-size: 0.72rem;
    color: var(--color-slate-500);
    line-height: 1.35;
  }
  .disclosure-compact-text.verified-note {
    color: var(--color-success);
    font-weight: 600;
  }
  .stock-status-line {
    font-size: 0.7rem;
    color: var(--color-slate-400);
  }

  .cta-action-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }
  .product-cta-btn {
    padding: 0.75rem 1.4rem;
    font-size: 0.92rem;
    font-weight: 700;
    border-radius: var(--radius-md);
  }
  .affiliate-direct-note {
    font-size: 0.68rem;
    color: var(--color-slate-400);
  }

  /* Responsive Stacking */
  @media (max-width: 820px) {
    .product-core-grid {
      grid-template-columns: 1fr;
    }
    .product-media-panel {
      min-height: 180px;
    }
    .pros-cons-container {
      grid-template-columns: 1fr;
    }
    .card-footer-strip {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
    }
    .cta-action-group {
      align-items: stretch;
    }
    .product-cta-btn {
      justify-content: center;
      min-height: 44px;
    }
    .affiliate-direct-note {
      text-align: center;
    }
  }

  @media (max-width: 640px) {
    .product-card {
      padding: 1.25rem 1rem;
      margin-bottom: 2rem;
    }
    .product-heading {
      font-size: 1.2rem;
    }
    .best-for-tag {
      font-size: 0.75rem;
      padding: 0.2rem 0.6rem;
    }
    .price-figure {
      font-size: 1.3rem;
    }
  }
</style>
