---
import { SITE_CONFIG } from '../config/site';
---

<footer class="main-footer">
  <!-- Amazon Affiliate Disclosure Notice -->
  <div class="footer-disclosure-strip">
    <div class="container">
      <p class="disclosure-text">
        <strong>Commercial Disclosure:</strong> {SITE_CONFIG.amazonDisclosure} Product prices, offers, and availability on Amazon India are subject to change. Always verify final details on Amazon.in before purchasing.
      </p>
    </div>
  </div>

  <div class="container footer-grid">
    <!-- Column 1: Brand & Mission -->
    <div class="footer-col brand-col">
      <div class="footer-logo">
        <div class="logo-mark">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
          </svg>
        </div>
        <span class="logo-text">Smart<span class="logo-accent">Finds</span> <span class="logo-sub">by DesiOffers</span></span>
      </div>
      <p class="footer-about">
        SmartFinds by DesiOffers delivers independent product discovery and buying-guide publications helping Indian shoppers find genuine recommendations without the marketing noise.
      </p>
      <div class="footer-socials">
        <a href={SITE_CONFIG.social.telegram} target="_blank" rel="noopener" aria-label="Join Telegram">
          <span>Telegram</span>
        </a>
        <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener" aria-label="Join WhatsApp">
          <span>WhatsApp</span>
        </a>
        <a href={SITE_CONFIG.social.twitter} target="_blank" rel="noopener" aria-label="Follow on Twitter">
          <span>Twitter</span>
        </a>
      </div>
    </div>

    <!-- Column 2: Main Categories -->
    <div class="footer-col">
      <h3 class="footer-heading">Top Categories</h3>
      <ul class="footer-links">
        <li><a href="/category/gaming/">Gaming Peripherals</a></li>
        <li><a href="/category/electronics-audio/">Audio & Electronics</a></li>
        <li><a href="/category/kitchen-appliances/">Kitchen & Appliances</a></li>
        <li><a href="/category/beauty-makeup/">Beauty & Personal Care</a></li>
        <li><a href="/category/home-living/">Home & Living Finds</a></li>
        <li><a href="/deals/">Curated Amazon Deals</a></li>
      </ul>
    </div>

    <!-- Column 3: More from DesiOffers Main Website -->
    <div class="footer-col">
      <h3 class="footer-heading">More from DesiOffers</h3>
      <ul class="footer-links">
        <li><a href={SITE_CONFIG.mainSiteUrl} target="_blank" rel="noopener">DesiOffers Main Site ↗</a></li>
        <li><a href={`${SITE_CONFIG.mainSiteUrl}`} target="_blank" rel="noopener">Hot Deals & Coupons ↗</a></li>
        <li><a href="/topics/best-gaming-keyboards/">Best Gaming Keyboards Hub</a></li>
        <li><a href="/topics/best-tws-earbuds/">Best TWS Earbuds Hub</a></li>
      </ul>
    </div>

    <!-- Column 4: Trust, Standards & Legal -->
    <div class="footer-col">
      <h3 class="footer-heading">Editorial & Legal</h3>
      <ul class="footer-links">
        <li><a href="/about/">About DesiOffers Guides</a></li>
        <li><a href="/authors/">Our Editorial Team</a></li>
        <li><a href="/methodology/">Evaluation Methodology</a></li>
        <li><a href="/affiliate-disclosure/">Affiliate Disclosure</a></li>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms of Service</a></li>
        <li><a href="/contact/">Contact Editorial Team</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom-bar">
    <div class="container footer-bottom-content">
      <p>© {new Date().getFullYear()} DesiOffers Guides. All rights reserved.</p>
      <div class="footer-bottom-links">
        <a href="/sitemap-index.xml">Sitemap</a>
        <a href="/rss.xml">RSS Feed</a>
        <a href="/llms.txt">LLMs Overview</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .main-footer {
    background-color: var(--color-slate-900);
    color: var(--color-slate-300);
    padding-top: 0;
  }
  .footer-disclosure-strip {
    background-color: var(--color-slate-950);
    border-bottom: 1px solid var(--color-slate-800);
    padding: 1rem 0;
  }
  .disclosure-text {
    font-size: 0.78rem;
    color: var(--color-slate-400);
    margin: 0;
    line-height: 1.5;
  }
  .disclosure-text strong {
    color: var(--color-slate-200);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .logo-mark {
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
  }
  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.02em;
  }
  .logo-accent {
    color: #c4b5fd;
  }
  .logo-sub {
    font-size: 0.72rem;
    color: var(--color-slate-400);
    font-weight: 600;
    margin-left: 0.25rem;
  }
  .footer-about {
    font-size: 0.85rem;
    color: var(--color-slate-400);
    margin-top: 0.85rem;
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }
  .footer-socials {
    display: flex;
    gap: 0.75rem;
  }
  .footer-socials a {
    font-size: 0.8rem;
    color: var(--color-primary-light);
    background-color: rgba(124, 58, 237, 0.15);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    text-decoration: none;

  }
  .footer-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-white);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0;
    margin-bottom: 1.25rem;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-links li {
    margin-bottom: 0.6rem;
  }
  .footer-links a {
    color: var(--color-slate-400);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-links a:hover {
    color: var(--color-white);
  }

  .footer-bottom-bar {
    border-top: 1px solid var(--color-slate-800);
    padding: 1.25rem 0;
    font-size: 0.8rem;
    color: var(--color-slate-500);
  }
  .footer-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .footer-bottom-links {
    display: flex;
    gap: 1rem;
  }
  .footer-bottom-links a {
    color: var(--color-slate-400);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom-content {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>
