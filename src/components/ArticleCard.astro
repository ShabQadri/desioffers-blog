---
import { getImageUrl, getImageAttributes } from '../utils/image';
import { formatDate } from '../utils/time';

interface Props {
  title: string;
  slug: string;
  description: string;
  categoryName: string;
  categorySlug: string;
  heroImage: string;
  heroImageAlt: string;
  publishedDate: Date;
  readingTime: number;
  authorName?: string;
  featured?: boolean;
  layout?: 'vertical' | 'horizontal';
}

const {
  title,
  slug,
  description,
  categoryName,
  categorySlug,
  heroImage,
  heroImageAlt,
  publishedDate,
  readingTime,
  authorName = 'Editorial Team',
  featured = false,
  layout = 'vertical',
} = Astro.props;

const isHorizontal = layout === 'horizontal';
const imageUrl = getImageUrl(heroImage, featured ? 'medium' : 'card');
const imgAttrs = getImageAttributes(featured ? 'medium' : 'card');
---

<article class={`article-card ${featured ? 'featured' : ''} ${isHorizontal ? 'horizontal' : ''}`}>
  <a href={`/${slug}/`} class="card-image-link" tab-index="-1" aria-label={`Read ${title}`}>
    <img
      src={imageUrl}
      alt={heroImageAlt || title}
      width={imgAttrs.width}
      height={imgAttrs.height}
      loading="lazy"
      decoding="async"
      class="card-img"
      onerror={`this.onerror=null;this.src='/images/articles/${slug}-hero.jpg';this.addEventListener('error',()=>this.src='/images/brand/placeholder.svg');`}
    />
  </a>

  <div class="card-body">
    <div class="card-meta-top">
      <a href={`/category/${categorySlug}/`} class="category-pill">{categoryName}</a>
      <span class="reading-time">{readingTime} min read</span>
    </div>

    <h3 class="card-title">
      <a href={`/${slug}/`}>{title}</a>
    </h3>

    <p class="card-excerpt">{description}</p>

    <div class="card-footer">
      <div class="footer-left">
        <span class="author-name">By {authorName}</span>
        <span class="dot">•</span>
        <span class="publish-date">{formatDate(publishedDate)}</span>
      </div>
      <a href={`/${slug}/`} class="read-more-link" aria-label={`Read guide: ${title}`}>
        <span>Read Guide</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>
  </div>
</article>

<style>
  .article-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-slate-300);
  }

  .card-image-link {
    display: block;
    overflow: hidden;
    background-color: var(--color-slate-100);
  }
  .card-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .article-card:hover .card-img {
    transform: scale(1.03);
  }

  .card-body {
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.65rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .category-pill {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    border: 1px solid var(--color-primary-border);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: all 0.15s ease;
  }
  .category-pill:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  .reading-time {
    font-size: 0.76rem;
    color: var(--color-slate-500);
    white-space: nowrap;
  }

  .card-title {
    font-size: 1.12rem;
    line-height: 1.35;
    margin-bottom: 0.5rem;
    letter-spacing: -0.015em;
    word-break: break-word;
    overflow-wrap: break-word;
  }
  .card-title a {
    color: var(--color-slate-900);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .card-title a:hover {
    color: var(--color-primary);
  }

  .card-excerpt {
    font-size: 0.88rem;
    color: var(--color-slate-600);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--color-slate-500);
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-slate-150);
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .footer-left {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .author-name {
    font-weight: 600;
    color: var(--color-slate-700);
  }
  .dot {
    color: var(--color-slate-400);
  }
  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-primary);
    text-decoration: none;
    transition: gap 0.15s ease;
    flex-shrink: 0;
    padding: 0.2rem 0;
  }
  .read-more-link:hover {
    gap: 0.4rem;
    color: var(--color-primary-hover);
  }

  /* Horizontal Layout Variant */
  .article-card.horizontal {
    display: grid;
    grid-template-columns: 240px 1fr;
  }
  .article-card.horizontal .card-image-link {
    height: 100%;
  }
  .article-card.horizontal .card-img {
    height: 100%;
    min-height: 190px;
  }

  .article-card.featured {
    grid-column: span 2;
  }

  @media (max-width: 768px) {
    .article-card.horizontal {
      grid-template-columns: 1fr;
    }
    .article-card.horizontal .card-img {
      height: auto;
      aspect-ratio: 16 / 9;
      min-height: 0;
    }
    .article-card.featured {
      grid-column: span 1;
    }
  }

  @media (max-width: 640px) {
    .card-body {
      padding: 1rem 1rem;
    }
    .card-img {
      height: auto;
      aspect-ratio: 16 / 9;
    }
    .card-title {
      font-size: 1.05rem;
    }
    .card-excerpt {
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }
  }
</style>

