---
import { SITE_CONFIG } from '../config/site';
---

<div class="top-announcement-bar">
  <div class="container top-bar-content">
    <div class="top-bar-left">
      <span class="disclosure-badge">AFFILIATE DISCLOSURE</span>
      <span class="disclosure-text">{SITE_CONFIG.amazonDisclosure}</span>
    </div>
    <div class="top-right-group">
      <a href={SITE_CONFIG.mainSiteUrl} class="main-site-link" target="_blank" rel="noopener">
        <span>Main DesiOffers Portal</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
      </a>
      <div class="social-mini-links">
        <a href={SITE_CONFIG.social.telegram} target="_blank" rel="noopener" aria-label="Join Telegram Channel">Telegram</a>
        <span class="divider">/</span>
        <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener" aria-label="Join WhatsApp Channel">WhatsApp</a>
      </div>
    </div>
  </div>
</div>

<header class="main-header">
  <div class="container header-container">
    <!-- Left: Brand Logo & Tagline -->
    <a href="/" class="brand-logo" aria-label="DesiOffers Guides Home">
      <div class="logo-mark">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </div>
      <div class="logo-text-group">
        <span class="logo-title">Smart<span class="logo-accent">Finds</span> <span class="logo-sub">by DesiOffers</span></span>
      </div>
    </a>

    <!-- Center: Primary Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <a href="/" class="nav-link">Home</a>

      <!-- Categories Dropdown Menu -->
      <div class="nav-dropdown-wrapper">
        <button class="nav-link nav-dropdown-btn" aria-haspopup="true" aria-expanded="false" id="categories-menu-button">
          <span>Categories</span>
          <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="nav-dropdown-menu" aria-labelledby="categories-menu-button">
          <div class="dropdown-header">Department Guides</div>
          <a href="/category/gaming/" class="dropdown-item">
            <span class="dropdown-icon">🎮</span>
            <div class="dropdown-item-text">
              <strong>Gaming Peripherals</strong>
              <small>Mice, keyboards, headsets & accessories</small>
            </div>
          </a>
          <a href="/category/electronics-audio/" class="dropdown-item">
            <span class="dropdown-icon">🎧</span>
            <div class="dropdown-item-text">
              <strong>Electronics & Audio</strong>
              <small>TWS earbuds, headphones & tech gifts</small>
            </div>
          </a>
          <a href="/category/kitchen-appliances/" class="dropdown-item">
            <span class="dropdown-icon">🍳</span>
            <div class="dropdown-item-text">
              <strong>Kitchen & Appliances</strong>
              <small>Air fryers, choppers & daily essentials</small>
            </div>
          </a>
          <a href="/category/beauty-makeup/" class="dropdown-item">
            <span class="dropdown-icon">💄</span>
            <div class="dropdown-item-text">
              <strong>Beauty & Makeup</strong>
              <small>Beginner kits, skincare & sets</small>
            </div>
          </a>
          <a href="/category/home-living/" class="dropdown-item">
            <span class="dropdown-icon">🏠</span>
            <div class="dropdown-item-text">
              <strong>Home & Living</strong>
              <small>Desk organizers & modern apartment finds</small>
            </div>
          </a>
          <div class="dropdown-footer">
            <a href="/deals/" class="dropdown-deals-link">🔥 View All Curated Amazon Deals →</a>
          </div>
        </div>
      </div>

      <a href="/deals/" class="nav-link deals-nav-link">
        <span class="deals-fire">🔥</span> Deals
      </a>
      <a href="/about/" class="nav-link">About</a>
      <a href="/contact/" class="nav-link">Contact</a>
    </nav>

    <!-- Right: Search & Action Controls -->
    <div class="header-actions">
      <a href="/search/" class="search-btn" aria-label="Search Guides">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-text">Search</span>
      </a>

      <button id="mobile-menu-toggle" class="mobile-toggle-btn" aria-label="Toggle Mobile Navigation" aria-expanded="false">
        <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="mobile-drawer" hidden>
    <nav class="mobile-nav-list">
      <div class="mobile-group-title">Navigation</div>
      <a href="/" class="mobile-nav-link">🏠 Home</a>
      <a href="/deals/" class="mobile-nav-link deals-highlight">🔥 Amazon India Deals & Price Drops</a>

      <div class="mobile-group-title">Explore Categories</div>
      <a href="/category/gaming/" class="mobile-nav-link">🎮 Gaming Peripherals</a>
      <a href="/category/electronics-audio/" class="mobile-nav-link">🎧 Electronics & Audio</a>
      <a href="/category/kitchen-appliances/" class="mobile-nav-link">🍳 Kitchen & Appliances</a>
      <a href="/category/beauty-makeup/" class="mobile-nav-link">💄 Beauty & Makeup</a>
      <a href="/category/home-living/" class="mobile-nav-link">🏠 Home & Living</a>

      <div class="mobile-group-title">Editorial & Trust</div>
      <a href="/about/" class="mobile-nav-link alt">About Us</a>
      <a href="/methodology/" class="mobile-nav-link alt">Evaluation Methodology</a>
      <a href="/contact/" class="mobile-nav-link alt">Contact Editorial Team</a>
      <a href={SITE_CONFIG.mainSiteUrl} target="_blank" rel="noopener" class="mobile-nav-link portal-link">Main DesiOffers.com Portal ↗</a>
    </nav>
  </div>
</header>

<script>
  // Mobile drawer toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      drawer.hidden = isExpanded;
    });
  }
</script>

<style>
  .top-announcement-bar {
    background-color: var(--color-slate-900);
    color: var(--color-slate-300);
    font-size: 0.76rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--color-slate-800);
  }
  .top-bar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .disclosure-badge {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    background-color: rgba(255, 255, 255, 0.12);
    color: #e2e8f0;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-xs);
  }
  .disclosure-text {
    color: var(--color-slate-300);
    font-size: 0.74rem;
  }
  .top-right-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }
  .main-site-link {
    color: #fde047;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .main-site-link:hover {
    color: #ffffff;
  }
  .social-mini-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
  }
  .social-mini-links a {
    color: var(--color-slate-400);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .social-mini-links a:hover {
    color: #ffffff;
  }
  .social-mini-links .divider {
    color: var(--color-slate-700);
  }

  .main-header {
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-slate-200);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.03);
  }
  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }
  .logo-mark {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-purple);
  }
  .logo-text-group {
    display: flex;
    flex-direction: column;
  }
  .logo-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-slate-900);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .logo-accent {
    color: var(--color-primary);
  }
  .logo-sub {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--color-slate-500);
    letter-spacing: 0;
    margin-left: 0.25rem;
  }

  /* Navigation Bar */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-link {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-slate-700);
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.15s ease;
    border: none;
    background: none;
    cursor: pointer;
    font-family: inherit;
  }
  .nav-link:hover {
    color: var(--color-primary);
  }
  .deals-nav-link {
    color: var(--color-deal);
    font-weight: 700;
  }
  .deals-nav-link:hover {
    color: #c2410c;
  }

  /* Dropdown styling */
  .nav-dropdown-wrapper {
    position: relative;
  }
  .nav-dropdown-btn .chevron-icon {
    transition: transform 0.2s ease;
  }
  .nav-dropdown-wrapper:hover .nav-dropdown-btn .chevron-icon,
  .nav-dropdown-wrapper:focus-within .nav-dropdown-btn .chevron-icon {
    transform: rotate(180deg);
  }
  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 320px;
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 0.75rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.2s ease;
    z-index: 1001;
  }
  .nav-dropdown-wrapper:hover .nav-dropdown-menu,
  .nav-dropdown-wrapper:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown-header {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-slate-400);
    padding: 0.4rem 0.6rem 0.25rem;
  }
  .dropdown-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.6rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .dropdown-item:hover {
    background-color: var(--color-primary-light);
  }
  .dropdown-icon {
    font-size: 1.25rem;
    line-height: 1;
    margin-top: 0.1rem;
  }
  .dropdown-item-text {
    display: flex;
    flex-direction: column;
  }
  .dropdown-item-text strong {
    font-size: 0.88rem;
    color: var(--color-slate-900);
    font-weight: 600;
  }
  .dropdown-item-text small {
    font-size: 0.74rem;
    color: var(--color-slate-500);
  }
  .dropdown-footer {
    border-top: 1px solid var(--color-slate-150);
    margin-top: 0.5rem;
    padding-top: 0.5rem;
  }
  .dropdown-deals-link {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-deal);
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
  }
  .dropdown-deals-link:hover {
    background-color: var(--color-deal-bg);
  }

  /* Search & Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .search-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background-color: var(--color-slate-100);
    color: var(--color-slate-700);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }
  .search-btn:hover {
    background-color: var(--color-slate-200);
    color: var(--color-slate-900);
    border-color: var(--color-slate-300);
  }

  .mobile-toggle-btn {
    display: none;
    background: none;
    border: none;
    color: var(--color-slate-800);
    cursor: pointer;
    padding: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-slate-200);
    padding: 1rem 1.25rem 1.5rem;
    box-shadow: var(--shadow-md);
    max-height: 80vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-group-title {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-slate-400);
    margin-top: 0.85rem;
    margin-bottom: 0.25rem;
    padding-left: 0.5rem;
  }
  .mobile-group-title:first-child {
    margin-top: 0;
  }
  .mobile-nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-slate-800);
    text-decoration: none;
    padding: 0.65rem 0.75rem;
    min-height: 44px;
    display: flex;
    align-items: center;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease;
  }
  .mobile-nav-link:hover {
    background-color: var(--color-slate-100);
    color: var(--color-primary);
  }
  .mobile-nav-link.deals-highlight {
    color: var(--color-deal);
    font-weight: 700;
    background-color: var(--color-deal-bg);
  }
  .mobile-nav-link.alt {
    font-size: 0.88rem;
    color: var(--color-slate-600);
  }
  .mobile-nav-link.portal-link {
    color: var(--color-primary);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .mobile-toggle-btn { display: inline-flex; }
    .mobile-drawer:not([hidden]) { display: block; }
    .search-text { display: none; }
    .search-btn {
      padding: 0.5rem;
      min-width: 40px;
      min-height: 40px;
      justify-content: center;
    }
    .main-site-link { display: none; }
  }

  @media (max-width: 640px) {
    .top-announcement-bar {
      padding: 0.4rem 0;
    }
    .top-bar-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
    .top-bar-left {
      white-space: normal;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .disclosure-text {
      font-size: 0.7rem;
      line-height: 1.35;
    }
    .top-right-group {
      width: 100%;
      justify-content: space-between;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 0.3rem;
    }
    .header-container {
      height: 64px;
    }
    .logo-mark {
      width: 32px;
      height: 32px;
    }
    .logo-title {
      font-size: 1.1rem;
    }
  }
</style>
