---
import { SITE_CONFIG } from '../config/site';
---

<div class="top-announcement-bar">
  <div class="container top-bar-content">
    <span>💡 {SITE_CONFIG.amazonDisclosure}</span>
    <div class="top-right-group">
      <a href={SITE_CONFIG.mainSiteUrl} class="main-site-link">Main DesiOffers Site →</a>
      <div class="social-mini-links">
        <a href={SITE_CONFIG.social.telegram} target="_blank" rel="noopener" aria-label="Join Telegram Channel">Telegram</a>
        <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener" aria-label="Join WhatsApp Channel">WhatsApp</a>
      </div>
    </div>
  </div>
</div>

<header class="main-header">
  <div class="container header-container">
    <!-- Left: Brand Logo & Tagline -->
    <a href="/" class="brand-logo" aria-label="DesiOffers Guides Home">
      <div class="logo-mark">D</div>
      <div class="logo-text-group">
        <span class="logo-title">DesiOffers<span class="accent-badge">Guides</span></span>
        <span class="logo-tagline">{SITE_CONFIG.tagline}</span>
      </div>
    </a>

    <!-- Center: Primary Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <a href="/" class="nav-link">Home</a>
      <a href="/category/gaming/" class="nav-link">Gaming</a>
      <a href="/category/beauty-makeup/" class="nav-link">Beauty</a>
      <a href="/category/kitchen-appliances/" class="nav-link">Kitchen</a>
      <a href="/category/electronics-audio/" class="nav-link">Electronics</a>
      <a href="/category/home-living/" class="nav-link">Home & Living</a>
      <a href="/deals/" class="nav-link deals-link">
        <span class="deals-badge">🔥</span> Deals
      </a>
      <a href={SITE_CONFIG.mainSiteUrl} target="_blank" rel="noopener" class="nav-link main-site-nav-btn">
        DesiOffers.com ↗
      </a>
    </nav>

    <!-- Right: Search Button & Mobile Toggle -->
    <div class="header-actions">
      <a href="/search/" class="search-btn" aria-label="Open Search Page">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-text">Search</span>
      </a>

      <button id="mobile-menu-toggle" class="mobile-toggle-btn" aria-label="Toggle Mobile Navigation" aria-expanded="false">
        <svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="mobile-drawer" hidden>
    <nav class="mobile-nav-list">
      <a href="/" class="mobile-nav-link">Home</a>
      <a href="/category/gaming/" class="mobile-nav-link">Gaming Gear</a>
      <a href="/category/beauty-makeup/" class="mobile-nav-link">Beauty & Makeup</a>
      <a href="/category/kitchen-appliances/" class="mobile-nav-link">Kitchen & Appliances</a>
      <a href="/category/electronics-audio/" class="mobile-nav-link">Electronics & Audio</a>
      <a href="/category/home-living/" class="mobile-nav-link">Home & Living</a>
      <a href="/deals/" class="mobile-nav-link deals-link">🔥 Amazon Deals & Offers</a>
      <a href={SITE_CONFIG.mainSiteUrl} target="_blank" rel="noopener" class="mobile-nav-link highlight">Main DesiOffers.com ↗</a>
      <a href="/about/" class="mobile-nav-link alt">About DesiOffers Guides</a>
      <a href="/methodology/" class="mobile-nav-link alt">How We Select Products</a>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      drawer.hidden = isExpanded;
    });
  }
</script>

<style>
  .top-announcement-bar {
    background-color: var(--color-slate-900);
    color: var(--color-slate-300);
    font-size: 0.75rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-slate-800);
  }
  .top-bar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .top-right-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .main-site-link {
    color: #fde047;
    font-weight: 700;
    text-decoration: none;
  }
  .social-mini-links {
    display: flex;
    gap: 0.8rem;
  }
  .social-mini-links a {
    color: var(--color-slate-400);
    text-decoration: none;
  }
  .social-mini-links a:hover {
    color: var(--color-white);
  }

  .main-header {
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-slate-200);
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }
  .logo-mark {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-hover) 100%);
    color: var(--color-white);
    font-weight: 800;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-purple);
  }
  .logo-text-group {
    display: flex;
    flex-direction: column;
  }
  .logo-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-slate-900);
    line-height: 1.1;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .accent-badge {
    font-size: 0.65rem;
    font-weight: 800;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .logo-tagline {
    font-size: 0.68rem;
    color: var(--color-slate-500);
    font-weight: 500;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-slate-700);
    text-decoration: none;
    padding: 0.35rem 0;
    transition: color 0.15s ease;
  }
  .nav-link:hover {
    color: var(--color-primary);
  }
  .deals-link {
    color: var(--color-danger);
  }
  .deals-link:hover {
    color: #b91c1c;
  }
  .main-site-nav-btn {
    color: var(--color-primary);
    font-weight: 700;
    background-color: var(--color-primary-light);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .search-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--color-slate-100);
    color: var(--color-slate-700);
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .search-btn:hover {
    background-color: var(--color-slate-200);
    color: var(--color-slate-900);
  }

  .mobile-toggle-btn {
    display: none;
    background: none;
    border: none;
    color: var(--color-slate-800);
    cursor: pointer;
    padding: 0.4rem;
  }

  .mobile-drawer {
    display: none;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-slate-200);
    padding: 1rem 1.25rem 1.5rem;
  }
  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .mobile-nav-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-slate-800);
    text-decoration: none;
  }
  .mobile-nav-link.highlight {
    color: var(--color-primary);
  }
  .mobile-nav-link.alt {
    font-size: 0.9rem;
    color: var(--color-slate-500);
  }

  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .mobile-toggle-btn { display: block; }
    .mobile-drawer:not([hidden]) { display: block; }
    .search-text { display: none; }
    .main-site-link { display: none; }
  }
</style>
