---
interface Props {
  name: string;
  slug: string;
  guideCount: number;
  color?: string;
  icon?: string;
}

const {
  name,
  slug,
  guideCount,
  color = '#7c3aed',
  icon = 'tag',
} = Astro.props;

// SVG Icons mapping for departments
function getCategorySvg(iconName: string) {
  switch (iconName) {
    case 'gamepad':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="12" x2="10" y2="12"></line><line x1="8" y1="10" x2="8" y2="14"></line><line x1="15" y1="13" x2="15.01" y2="13"></line><line x1="18" y1="11" x2="18.01" y2="11"></line><rect x="2" y="6" width="20" height="12" rx="2"></rect></svg>`;
    case 'sparkles':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg>`;
    case 'utensils':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2v6a3 3 0 0 1-3 3 3 3 0 0 1-3-3V2"></path><path d="M15 11v11"></path><path d="M5 2v4a3 3 0 0 0 3 3 3 3 0 0 0 3-3V2"></path><path d="M8 9v13"></path></svg>`;
    case 'headphones':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg>`;
    case 'home':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`;
    case 'tag':
    default:
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"></path><path d="M7 7h.01"></path></svg>`;
  }
}
---

<a href={`/category/${slug}/`} class="category-card" aria-label={`Explore ${name} guides`}>
  <div class="category-icon-box" style={`--cat-color: ${color};`}>
    <Fragment set:html={getCategorySvg(icon)} />
  </div>
  <div class="category-text">
    <h3 class="category-title">{name}</h3>
    <span class="category-count">{guideCount} {guideCount === 1 ? 'Guide' : 'Guides'}</span>
  </div>
</a>

<style>
  .category-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    box-shadow: var(--shadow-subtle);
    transition: all 0.2s ease;
  }

  .category-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary-border);
    box-shadow: var(--shadow-md);
    background-color: var(--color-primary-subtle);
  }

  .category-icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--color-primary-light);
    color: var(--cat-color, var(--color-primary));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .category-card:hover .category-icon-box {
    transform: scale(1.08);
    background-color: var(--color-white);
  }

  .category-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .category-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-slate-900);
    line-height: 1.25;
    margin: 0;
  }

  .category-count {
    font-size: 0.76rem;
    color: var(--color-slate-500);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .category-card {
      padding: 1rem 0.75rem;
      min-height: 110px;
      justify-content: center;
    }
    .category-icon-box {
      width: 42px;
      height: 42px;
      margin-bottom: 0.5rem;
    }
    .category-title {
      font-size: 0.88rem;
    }
    .category-count {
      font-size: 0.72rem;
    }
  }
</style>
