---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../config/site';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const categories = await getCollection('categories');
const authors = await getCollection('authors');

// Sort articles by published date descending
const sortedArticles = allArticles.sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);

const featuredArticle = sortedArticles.find((a) => a.data.featured) || sortedArticles[0];
const latestArticles = sortedArticles.filter((a) => a.slug !== featuredArticle.slug).slice(0, 6);

// Helper mapping for category name and author name
const categoryMap = new Map(categories.map((c) => [c.id, c.data]));
const authorMap = new Map(authors.map((a) => [a.id, a.data]));
---

<BaseLayout
  title={`${SITE_CONFIG.name} | ${SITE_CONFIG.tagline}`}
  description={SITE_CONFIG.description}
>
  <!-- Hero Featured Article Area -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-card">
        <div class="hero-content">
          <div class="hero-badge">FEATURED BUYING GUIDE</div>
          <h1 class="hero-title">
            <a href={`/${featuredArticle.slug}/`}>{featuredArticle.data.title}</a>
          </h1>
          <p class="hero-description">{featuredArticle.data.description}</p>

          <div class="hero-meta">
            <span class="category-tag">{categoryMap.get(featuredArticle.data.category.id)?.name || 'Gaming'}</span>
            <span class="dot">•</span>
            <span>By {authorMap.get(featuredArticle.data.author.id)?.name || 'Rahul Sharma'}</span>
            <span class="dot">•</span>
            <span>{featuredArticle.data.readingTime} min read</span>
          </div>

          <div class="hero-actions">
            <a href={`/${featuredArticle.slug}/`} class="btn btn-primary">
              <span>Read the Full Guide</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>

        <div class="hero-image-wrapper">
          <img
            src={featuredArticle.data.heroImage}
            alt={featuredArticle.data.heroImageAlt}
            width="800"
            height="533"
            style="aspect-ratio: 3/2;"
            loading="eager"
            fetchpriority="high"
            class="hero-img"
            onerror="this.onerror=null;this.src='/images/brand/placeholder.webp';"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Top Categories Section -->
  <section class="top-categories-section">
    <div class="container">
      <div class="section-header-row">
        <div>
          <h2 class="section-heading">Browse Top Categories</h2>
          <p class="section-subheading">Explore handpicked buying guides organized by department</p>
        </div>
      </div>

      <div class="categories-grid">
        {categories.map((cat) => {
          const catArticles = allArticles.filter((a) => a.data.category.id === cat.id);
          return (
            <a href={`/category/${cat.data.slug}/`} class="category-card-link">
              <div class="category-card-box">
                <div class="cat-icon-badge" style={`background-color: ${cat.data.color}15; color: ${cat.data.color};`}>
                  {cat.data.name.charAt(0)}
                </div>
                <div class="cat-info">
                  <h3 class="cat-name">{cat.data.name}</h3>
                  <span class="cat-count">{catArticles.length} Guides</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Latest Articles Feed + Desktop Sidebar Layout -->
  <section class="main-feed-section">
    <div class="container feed-container-grid">
      <!-- Main Content Feed -->
      <div class="feed-main-col">
        <h2 class="section-heading">Latest Editorial Guides</h2>

        <div class="articles-feed-grid">
          {latestArticles.map((article) => {
            const cat = categoryMap.get(article.data.category.id);
            const auth = authorMap.get(article.data.author.id);
            return (
              <ArticleCard
                title={article.data.title}
                slug={article.slug}
                description={article.data.description}
                categoryName={cat?.name || 'General'}
                categorySlug={cat?.slug || 'gaming'}
                heroImage={article.data.heroImage}
                heroImageAlt={article.data.heroImageAlt}
                publishedDate={article.data.publishedDate}
                readingTime={article.data.readingTime}
                authorName={auth?.name}
              />
            );
          })}
        </div>
      </div>

      <!-- Desktop Sidebar -->
      <aside class="feed-sidebar-col">
        <div class="sidebar-box about-box">
          <h3 class="sidebar-title">Why Trust DesiOffers?</h3>
          <p class="sidebar-text">
            We simplify product choices for Indian buyers with clear, specification-based research, verified INR pricing, and transparent Amazon affiliate disclosures.
          </p>
          <a href="/methodology/" class="sidebar-link">Our Evaluation Process →</a>
        </div>

        <!-- Sidebar Box 2: Join Channels -->
        <div class="sidebar-box channels-box">
          <h3 class="sidebar-title">Never Miss a Price Drop</h3>
          <p class="sidebar-text">Get instant notifications on Amazon India lightning sales and price cut alerts.</p>
          <div class="channel-buttons">
            <a href={SITE_CONFIG.social.telegram} target="_blank" rel="noopener" class="btn btn-secondary channel-btn">
              Join Telegram
            </a>
            <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener" class="btn btn-secondary channel-btn">
              Join WhatsApp
            </a>
          </div>
        </div>

        <!-- Sidebar Box 3: Popular Tags -->
        <div class="sidebar-box tags-box">
          <h3 class="sidebar-title">Popular Shopping Intent</h3>
          <div class="sidebar-tags-cloud">
            <a href="/tag/under-2000/">Under ₹2,000</a>
            <a href="/tag/under-5000/">Under ₹5,000</a>
            <a href="/tag/wireless/">Wireless Tech</a>
            <a href="/tag/mechanical/">Mechanical Switches</a>
            <a href="/tag/indian-homes/">Indian Homes</a>
            <a href="/tag/budget/">Budget Finds</a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding: 2rem 0;
  }
  .hero-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .hero-content {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    display: inline-block;
    margin-bottom: 1rem;
    align-self: flex-start;
  }
  .hero-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.25;
    margin-bottom: 1rem;
  }
  .hero-title a {
    color: var(--color-slate-900);
    text-decoration: none;
  }
  .hero-title a:hover {
    color: var(--color-primary);
  }
  .hero-description {
    font-size: 1.05rem;
    color: var(--color-slate-600);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }
  .hero-meta {
    font-size: 0.85rem;
    color: var(--color-slate-500);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .category-tag {
    font-weight: 700;
    color: var(--color-slate-800);
  }

  .hero-image-wrapper {
    background-color: var(--color-slate-100);
    overflow: hidden;
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .top-categories-section {
    padding: 2rem 0 3rem;
  }
  .section-heading {
    font-size: 1.6rem;
    margin-bottom: 0.25rem;
  }
  .section-subheading {
    font-size: 0.95rem;
    color: var(--color-slate-500);
    margin-bottom: 1.5rem;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .category-card-link {
    text-decoration: none;
  }
  .category-card-box {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .category-card-box:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    border-color: var(--color-slate-300);
  }
  .cat-icon-badge {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.2rem;
  }
  .cat-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-slate-900);
    margin: 0;
  }
  .cat-count {
    font-size: 0.75rem;
    color: var(--color-slate-500);
  }

  .main-feed-section {
    padding-bottom: 3rem;
  }
  .feed-container-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
  }
  .articles-feed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .sidebar-box {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .sidebar-title {
    font-size: 1.05rem;
    margin-top: 0;
    margin-bottom: 0.6rem;
  }
  .sidebar-text {
    font-size: 0.875rem;
    color: var(--color-slate-600);
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .sidebar-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .channel-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .channel-btn {
    font-size: 0.85rem;
    padding: 0.5rem;
  }

  .sidebar-tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .sidebar-tags-cloud a {
    background-color: var(--color-slate-100);
    color: var(--color-slate-700);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    text-decoration: none;
  }
  .sidebar-tags-cloud a:hover {
    background-color: var(--color-primary-light);
    color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .hero-card { grid-template-columns: 1fr; }
    .feed-container-grid { grid-template-columns: 1fr; }
  }
</style>
