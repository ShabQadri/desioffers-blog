---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HeroSlider, { type FeaturedSlideItem } from '../components/HeroSlider.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { SITE_CONFIG } from '../config/site';
import { getImageUrl } from '../utils/image';
import { formatDate } from '../utils/time';
import fs from 'node:fs';
import path from 'node:path';

// Strictly fetch only published, non-draft articles
const allArticles = await getCollection('articles', ({ data }: CollectionEntry<'articles'>) => !data.draft);
const categories: CollectionEntry<'categories'>[] = await getCollection('categories');
const authors: CollectionEntry<'authors'>[] = await getCollection('authors');

// Sort published articles by date descending
const sortedArticles = allArticles.sort(
  (a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) =>
    b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);

// Helper maps
const categoryMap = new Map<string, CollectionEntry<'categories'>['data']>(
  categories.map((c: CollectionEntry<'categories'>) => [c.id, c.data])
);
const authorMap = new Map<string, CollectionEntry<'authors'>['data']>(
  authors.map((a: CollectionEntry<'authors'>) => [a.id, a.data])
);

// Helper to determine if an article has valid/verified hero media
function hasValidHeroMedia(article: CollectionEntry<'articles'>): boolean {
  const hero = article.data.heroImage;
  if (!hero || hero.trim() === '') return false;
  const trimmed = hero.trim();
  // Valid R2 key or external URL
  if (!trimmed.startsWith('/') || trimmed.startsWith('http://') || trimmed.startsWith('https://')) return true;
  // Local static file check
  const localFile = path.join(process.cwd(), 'public', trimmed.replace(/^\/+/, ''));
  if (fs.existsSync(localFile)) return true;
  // Slug-based local fallback check
  const slugFile = path.join(process.cwd(), 'public', 'images', 'articles', `${article.slug}-hero.jpg`);
  if (fs.existsSync(slugFile)) return true;
  return false;
}

// Hero Slider: Prefer featured articles with valid media; fall back to latest published with valid media
const validFeatured = sortedArticles.filter((a: CollectionEntry<'articles'>) => a.data.featured && hasValidHeroMedia(a));
const validNonFeatured = sortedArticles.filter((a: CollectionEntry<'articles'>) => !a.data.featured && hasValidHeroMedia(a));
const validPool = [...validFeatured, ...validNonFeatured];
const sliderArticles = (validPool.length >= 1 ? validPool : sortedArticles).slice(0, 3);

const sliderSlides: FeaturedSlideItem[] = sliderArticles.map((article: CollectionEntry<'articles'>) => {
  const cat = categoryMap.get(article.data.category.id);
  const auth = authorMap.get(article.data.author.id);
  return {
    article,
    categoryName: cat?.name || 'Buying Guide',
    categorySlug: cat?.slug || 'gaming',
    authorName: auth?.name || 'Editorial Team',
  };
});

// Category cards with live published counts
const categoryCards = categories.map((cat: CollectionEntry<'categories'>) => ({
  name: cat.data.name,
  slug: cat.data.slug,
  color: cat.data.color,
  icon: cat.data.icon,
  guideCount: allArticles.filter((a: CollectionEntry<'articles'>) => a.data.category.id === cat.id).length,
}));

// Latest Feed articles & Popular articles pools
const latestFeedArticles = sortedArticles.slice(0, 6);
const popularArticles = sortedArticles.slice(2, 6);

// Feed articles with category and author precomputed
interface FeedArticleItem {
  article: CollectionEntry<'articles'>;
  categoryName: string;
  categorySlug: string;
  authorName: string;
}

const feedArticleItems: FeedArticleItem[] = latestFeedArticles.map((article: CollectionEntry<'articles'>) => {
  const cat = categoryMap.get(article.data.category.id);
  const auth = authorMap.get(article.data.author.id);
  return {
    article,
    categoryName: cat?.name || 'General',
    categorySlug: cat?.slug || 'gaming',
    authorName: auth?.name || 'Editorial Team',
  };
});

// Popular This Week articles with precomputed thumbnails and meta
interface PopularArticleItem {
  article: CollectionEntry<'articles'>;
  categoryName: string;
  thumbnailUrl: string;
  formattedDate: string;
}

const popularArticleItems: PopularArticleItem[] = popularArticles.map((art: CollectionEntry<'articles'>) => {
  const cat = categoryMap.get(art.data.category.id);
  return {
    article: art,
    categoryName: cat?.name || 'Guide',
    thumbnailUrl: getImageUrl(art.data.heroImage, 'thumbnail'),
    formattedDate: formatDate(art.data.publishedDate),
  };
});
---

<BaseLayout
  title={`${SITE_CONFIG.name} | ${SITE_CONFIG.tagline}`}
  description={SITE_CONFIG.description}
>
  <!-- 1. Hero Featured Article Slider -->
  <HeroSlider slides={sliderSlides} />

  <!-- 2. Top Categories Section -->
  <section class="categories-section" aria-label="Browse Top Categories">
    <div class="container">
      <div class="section-title-bar">
        <div>
          <h2 class="section-title">Top Categories</h2>
          <p class="section-subtitle">Explore handpicked buying guides organized by department</p>
        </div>
      </div>

      <div class="categories-grid">
        {categoryCards.map((cat) => (
          <CategoryCard
            name={cat.name}
            slug={cat.slug}
            guideCount={cat.guideCount}
            color={cat.color}
            icon={cat.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Main Content: Latest Articles (2/3) + Sidebar (1/3) -->
  <section class="main-content-section" aria-label="Latest Guides & Recommendations">
    <div class="container feed-sidebar-layout">
      <!-- Main Column: Latest Articles Feed -->
      <div class="feed-main-col">
        <div class="section-title-bar">
          <div>
            <h2 class="section-title">Latest Buying Guides</h2>
            <p class="section-subtitle">Specification-first evaluations with observed Indian pricing</p>
          </div>
          <a href="/deals/" class="section-top-link">
            <span>View Hot Deals</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>

        <div class="articles-feed-list">
          {feedArticleItems.map(({ article, categoryName, categorySlug, authorName }) => (
            <ArticleCard
              title={article.data.title}
              slug={article.slug}
              description={article.data.description}
              categoryName={categoryName}
              categorySlug={categorySlug}
              heroImage={article.data.heroImage}
              heroImageAlt={article.data.heroImageAlt}
              publishedDate={article.data.publishedDate}
              readingTime={article.data.readingTime}
              authorName={authorName}
              layout="horizontal"
            />
          ))}
        </div>
      </div>

      <!-- Right Column: Sidebar Widgets -->
      <aside class="sidebar-col">
        <!-- Widget 1: About SmartFinds -->
        <div class="sidebar-card about-widget">
          <div class="widget-header">
            <span class="widget-icon-pill">⭐</span>
            <h3 class="widget-title">About SmartFinds</h3>
          </div>
          <p class="widget-text">
            SmartFinds by DesiOffers delivers unbiased, specification-driven buying guides for Indian shoppers. We research genuine products, monitor observed prices, and disclose affiliate connections transparently.
          </p>
          <a href="/methodology/" class="widget-link">
            <span>Our Editorial Standards</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>

        <!-- Widget 2: Popular This Week -->
        <div class="sidebar-card popular-widget">
          <div class="widget-header">
            <span class="widget-icon-pill">🔥</span>
            <h3 class="widget-title">Popular This Week</h3>
          </div>
          <div class="popular-list">
            {popularArticleItems.map(({ article, categoryName, thumbnailUrl, formattedDate }, idx: number) => (
              <a href={`/${article.slug}/`} class="popular-item" aria-label={`Read ${article.data.title}`}>
                <div class="popular-num">{idx + 1}</div>
                <img
                  src={thumbnailUrl}
                  alt={article.data.title}
                  width="64"
                  height="64"
                  loading="lazy"
                  class="popular-thumb"
                  onerror="this.onerror=null;this.src='/images/brand/placeholder.svg';"
                />
                <div class="popular-info">
                  <span class="popular-cat">{categoryName}</span>
                  <h4 class="popular-title">{article.data.title}</h4>
                  <span class="popular-date">{formattedDate}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Widget 3: Join Channels -->
        <div class="sidebar-card channels-widget">
          <div class="widget-header">
            <span class="widget-icon-pill">🔔</span>
            <h3 class="widget-title">Join Our Channels</h3>
          </div>
          <p class="widget-text">Get instant notifications on Amazon India lightning sales, price drops, and curated buying guides.</p>
          <div class="channel-buttons-group">
            <a href={SITE_CONFIG.social.telegram} target="_blank" rel="noopener" class="btn channel-btn telegram-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .37z"/></svg>
              <span>Join Telegram</span>
            </a>
            <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener" class="btn channel-btn whatsapp-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 01-1.26-4.36c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.71 4.3 3.8 2.53 1.09 2.53.73 2.99.69.46-.04 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29z"/></svg>
              <span>Join WhatsApp</span>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- 4. Newsletter Section -->
  <Newsletter />
</BaseLayout>

<style>
  /* Section Header Bars */
  .section-title-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }
  .section-title {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    color: var(--color-slate-900);
    margin-bottom: 0.25rem;
    letter-spacing: -0.02em;
  }
  .section-subtitle {
    font-size: 0.9rem;
    color: var(--color-slate-500);
    margin: 0;
  }
  .section-top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-deal);
    text-decoration: none;
    transition: gap 0.15s ease;
    white-space: nowrap;
  }
  .section-top-link:hover {
    gap: 0.5rem;
    color: #c2410c;
  }

  /* Top Categories Section */
  .categories-section {
    padding: 1rem 0 2.5rem;
  }
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
  }

  /* Main Feed & Sidebar Layout */
  .main-content-section {
    padding: 1.5rem 0 3rem;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }
  .feed-sidebar-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 2.5rem;
    align-items: start;
    width: 100%;
    max-width: var(--container-max-width);
    min-width: 0;
  }
  .feed-main-col {
    min-width: 0;
    width: 100%;
    max-width: 100%;
  }

  .articles-feed-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
    width: 100%;
    max-width: 100%;
  }

  /* Sidebar Widgets */
  .sidebar-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
    width: 100%;
    max-width: 100%;
  }
  .sidebar-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-subtle);
    min-width: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .widget-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    min-width: 0;
  }
  .widget-icon-pill {
    font-size: 1.1rem;
  }
  .widget-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-slate-900);
    margin: 0;
    letter-spacing: -0.015em;
  }
  .widget-text {
    font-size: 0.88rem;
    color: var(--color-slate-600);
    line-height: 1.55;
    margin-bottom: 1rem;
    min-width: 0;
  }
  .widget-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    transition: gap 0.15s ease;
  }
  .widget-link:hover {
    gap: 0.5rem;
    color: var(--color-primary-hover);
  }

  /* Popular List */
  .popular-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
    width: 100%;
  }
  .popular-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    padding: 0.5rem;
    border-radius: var(--radius-md);
    transition: background-color 0.15s ease;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }
  .popular-item:hover {
    background-color: var(--color-slate-100);
  }
  .popular-num {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-slate-300);
    width: 20px;
    text-align: center;
    flex-shrink: 0;
  }
  .popular-thumb {
    width: 54px;
    height: 54px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    background-color: var(--color-slate-100);
    flex-shrink: 0;
  }
  .popular-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
    overflow: hidden;
  }
  .popular-cat {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary);
  }
  .popular-title {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-slate-800);
    line-height: 1.3;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    max-width: 100%;
  }
  .popular-item:hover .popular-title {
    color: var(--color-primary);
  }
  .popular-date {
    font-size: 0.72rem;
    color: var(--color-slate-500);
  }

  /* Channel Buttons */
  .channel-buttons-group {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    min-width: 0;
    width: 100%;
  }
  .channel-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.65rem 1rem;
    box-sizing: border-box;
  }
  .telegram-btn {
    background-color: #229ed9;
    color: #ffffff;
  }
  .telegram-btn:hover {
    background-color: #1b85b8;
    color: #ffffff;
  }
  .whatsapp-btn {
    background-color: #25d366;
    color: #ffffff;
  }
  .whatsapp-btn:hover {
    background-color: #1ebd59;
    color: #ffffff;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1100px) {
    .categories-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .feed-sidebar-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .categories-section {
      padding: 0.5rem 0 1.75rem;
    }
    .categories-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .section-title-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      margin-bottom: 1rem;
      min-width: 0;
    }
    .main-content-section {
      padding: 1rem 0 2.5rem;
    }
    .feed-sidebar-layout {
      gap: 2rem;
    }
    .sidebar-card {
      padding: 1.25rem 1rem;
    }
  }
</style>
