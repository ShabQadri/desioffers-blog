---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getTagRobotsDirective } from '../../utils/taxonomy';

export async function getStaticPaths() {
  const tags: CollectionEntry<'tags'>[] = await getCollection('tags');
  const articles: CollectionEntry<'articles'>[] = await getCollection('articles', ({ data }: CollectionEntry<'articles'>) => !data.draft);
  const categories: CollectionEntry<'categories'>[] = await getCollection('categories');
  const authors: CollectionEntry<'authors'>[] = await getCollection('authors');

  const categoryMap = new Map<string, CollectionEntry<'categories'>['data']>(
    categories.map((c: CollectionEntry<'categories'>) => [c.id, c.data])
  );
  const authorMap = new Map<string, CollectionEntry<'authors'>['data']>(
    authors.map((a: CollectionEntry<'authors'>) => [a.id, a.data])
  );

  return tags.map((tag: CollectionEntry<'tags'>) => {
    const tagArticles = articles
      .filter((a: CollectionEntry<'articles'>) => a.data.tags && a.data.tags.some((tRef: { id: string }) => tRef.id === tag.id))
      .sort((a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());

    return {
      params: { slug: tag.data.slug },
      props: {
        tag: tag.data,
        tagArticles,
        categoryMap,
        authorMap,
      },
    };
  });
}

interface Props {
  tag: CollectionEntry<'tags'>['data'];
  tagArticles: CollectionEntry<'articles'>[];
  categoryMap: Map<string, CollectionEntry<'categories'>['data']>;
  authorMap: Map<string, CollectionEntry<'authors'>['data']>;
}

const { tag, tagArticles, categoryMap, authorMap } = Astro.props;

const robotsDirective = getTagRobotsDirective(tag, tagArticles.length);
const breadcrumbs = [
  { label: 'Home', url: '/' },
  { label: 'Topics', url: '#' },
  { label: tag.name, url: `/tag/${tag.slug}/`, isCurrent: true },
];
---

<BaseLayout
  title={tag.seoTitle || `${tag.name} Product Guides & Recommendations | DesiOffers Guides`}
  description={tag.seoDescription || tag.description}
  robots={robotsDirective}
  breadcrumbs={breadcrumbs}
>
  <div class="container tag-page-container">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Tag Header Card -->
    <header class="tag-header-card">
      <div class="header-badge-row">
        <span class="tag-eyebrow">TOPIC ARCHIVE</span>
        <span class="guide-count-badge">{tagArticles.length} Curated {tagArticles.length === 1 ? 'Guide' : 'Guides'}</span>
      </div>
      <h1 class="tag-h1">{tag.name}</h1>
      <p class="tag-desc">{tag.description}</p>
    </header>

    {tag.status === 'merged' && tag.mergedIntoSlug && (
      <div class="tag-merged-notice">
        <p>ℹ️ This topic has been consolidated into <a href={`/tag/${tag.mergedIntoSlug}/`}>/tag/{tag.mergedIntoSlug}/</a>.</p>
      </div>
    )}

    <!-- 2-Column Layout -->
    <div class="tag-layout-grid">
      <main class="tag-feed-column">
        {tagArticles.length > 0 ? (
          <div class="tag-articles-grid">
            {tagArticles.map((article, idx) => {
              const cat = categoryMap.get(article.data.category.id);
              const auth = authorMap.get(article.data.author.id);
              return (
                <ArticleCard
                  title={article.data.title}
                  slug={article.slug}
                  description={article.data.description}
                  categoryName={cat?.name || 'General'}
                  categorySlug={cat?.slug || 'gaming'}
                  heroImage={article.data.heroImage}
                  heroImageAlt={article.data.heroImageAlt}
                  publishedDate={article.data.publishedDate}
                  readingTime={article.data.readingTime}
                  authorName={auth?.name}
                  featured={idx === 0}
                  layout={idx === 0 ? 'horizontal' : 'vertical'}
                />
              );
            })}
          </div>
        ) : (
          <div class="empty-tag-box">
            <span class="empty-icon">🏷️</span>
            <h3>No Guides Tagged With "{tag.name}" Yet</h3>
            <p>Explore our main departments and top curated buying guides.</p>
            <a href="/" class="btn btn-primary" style="margin-top: 1rem;">Explore All Guides</a>
          </div>
        )}
      </main>

      <aside class="tag-sidebar-column">
        <div class="sidebar-card">
          <h3 class="sidebar-heading">About This Archive</h3>
          <p class="sidebar-text">
            SmartFinds tag archives index verified product roundups, budget shortlists, and buying advice relevant to {tag.name}.
          </p>
          <div class="trust-badge-row">
            <span class="trust-badge">✓ Verified In Stock</span>
            <span class="trust-badge">✓ Real INR Value</span>
          </div>
        </div>

        <div class="sidebar-card highlight-card">
          <h3 class="sidebar-heading">Join SmartFinds Community</h3>
          <p class="sidebar-text">
            Get instant alerts on price drops, lightning deals, and new buying guides directly in your feed.
          </p>
          <div class="channel-buttons">
            <a href="https://t.me/desioffers" target="_blank" rel="noopener" class="btn-channel telegram">
              <span>✈️ Telegram Alerts</span>
            </a>
            <a href="https://whatsapp.com/channel/desioffers" target="_blank" rel="noopener" class="btn-channel whatsapp">
              <span>💬 WhatsApp Channel</span>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .tag-page-container {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  /* Header Card */
  .tag-header-card {
    background: linear-gradient(135deg, var(--color-white) 0%, var(--color-primary-light) 100%);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    padding: 2.25rem 2.5rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-subtle);
  }
  .header-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .tag-eyebrow {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--color-primary);
    background-color: var(--color-white);
    border: 1px solid var(--color-primary-border);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .guide-count-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-slate-600);
  }
  .tag-h1 {
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: var(--color-slate-900);
    letter-spacing: -0.025em;
    margin-bottom: 0.6rem;
    line-height: 1.15;
  }
  .tag-desc {
    font-size: 1.05rem;
    color: var(--color-slate-600);
    line-height: 1.6;
    max-width: 780px;
    margin: 0;
  }

  .tag-merged-notice {
    background-color: var(--color-warning-bg);
    border: 1px solid #fcd34d;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    margin-bottom: 2rem;
    font-size: 0.92rem;
    color: #92400e;
  }
  .tag-merged-notice a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
  }

  /* 2-Column Layout */
  .tag-layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 2.25rem;
    align-items: start;
    width: 100%;
    min-width: 0;
  }
  .tag-main-column {
    min-width: 0;
    width: 100%;
    max-width: 100%;
  }

  .tag-articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    min-width: 0;
    width: 100%;
  }

  .empty-tag-box {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 4rem 2rem;
    text-align: center;
    box-shadow: var(--shadow-subtle);
    min-width: 0;
    width: 100%;
  }
  .empty-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
  }
  .empty-tag-box h3 {
    font-size: 1.35rem;
    color: var(--color-slate-800);
    margin-bottom: 0.5rem;
  }
  .empty-tag-box p {
    color: var(--color-slate-600);
    font-size: 0.95rem;
    max-width: 480px;
    margin: 0 auto;
  }

  /* Sidebar */
  .tag-sidebar-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sidebar-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-subtle);
  }
  .sidebar-card.highlight-card {
    background: linear-gradient(135deg, var(--color-white) 0%, var(--color-primary-light) 100%);
    border-color: var(--color-primary-border);
  }
  .sidebar-heading {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-slate-900);
    margin-bottom: 0.65rem;
  }
  .sidebar-text {
    font-size: 0.88rem;
    color: var(--color-slate-600);
    line-height: 1.55;
    margin-bottom: 1rem;
  }
  .trust-badge-row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .trust-badge {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-emerald-700);
    background-color: var(--color-emerald-50);
    border: 1px solid var(--color-emerald-200);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-md);
    width: fit-content;
  }
  .channel-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .btn-channel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .btn-channel.telegram {
    background-color: #0088cc;
    color: #ffffff;
  }
  .btn-channel.telegram:hover {
    background-color: #0077b5;
  }
  .btn-channel.whatsapp {
    background-color: #25d366;
    color: #ffffff;
  }
  .btn-channel.whatsapp:hover {
    background-color: #20ba59;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .tag-layout-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .tag-sidebar-column {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      min-width: 0;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .tag-page-container {
      padding-top: 0.75rem;
      padding-bottom: 3rem;
    }
    .tag-header-card {
      padding: 1.5rem 1.25rem;
      margin-bottom: 1.25rem;
    }
    .tag-h1 {
      font-size: clamp(1.6rem, 5vw, 2.1rem);
    }
    .tag-desc {
      font-size: 0.95rem;
    }
    .tag-layout-grid {
      gap: 2rem;
    }
    .tag-articles-grid {
      grid-template-columns: 1fr;
    }
    .tag-sidebar-column {
      grid-template-columns: 1fr;
    }
    .sidebar-card {
      padding: 1.25rem 1rem;
    }
  }
</style>
