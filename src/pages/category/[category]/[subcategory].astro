---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { buildBreadcrumbs } from '../../../utils/taxonomy';

export async function getStaticPaths() {
  const categories: CollectionEntry<'categories'>[] = await getCollection('categories');
  const subcategories: CollectionEntry<'subcategories'>[] = await getCollection('subcategories');
  const articles: CollectionEntry<'articles'>[] = await getCollection('articles', ({ data }: CollectionEntry<'articles'>) => !data.draft);
  const authors: CollectionEntry<'authors'>[] = await getCollection('authors');

  const categoryMap = new Map<string, CollectionEntry<'categories'>['data']>(
    categories.map((c: CollectionEntry<'categories'>) => [c.id, c.data])
  );
  const authorMap = new Map<string, CollectionEntry<'authors'>['data']>(
    authors.map((a: CollectionEntry<'authors'>) => [a.id, a.data])
  );

  return subcategories.map((subcategory: CollectionEntry<'subcategories'>) => {
    const parentCategory = categoryMap.get(subcategory.data.category.id) || {
      name: 'General',
      slug: 'general',
      description: 'General buying guides',
      color: '#6366f1',
    };
    const subcategoryArticles = articles
      .filter((a: CollectionEntry<'articles'>) => a.data.subcategory && a.data.subcategory.id === subcategory.id)
      .sort((a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());

    return {
      params: {
        category: parentCategory.slug,
        subcategory: subcategory.data.slug,
      },
      props: {
        subcategory: subcategory.data,
        parentCategory,
        subcategoryArticles,
        authorMap,
      },
    };
  });
}

interface Props {
  subcategory: CollectionEntry<'subcategories'>['data'];
  parentCategory: CollectionEntry<'categories'>['data'];
  subcategoryArticles: CollectionEntry<'articles'>[];
  authorMap: Map<string, CollectionEntry<'authors'>['data']>;
}

const { subcategory, parentCategory, subcategoryArticles, authorMap } = Astro.props;

const breadcrumbs = buildBreadcrumbs({
  categoryName: parentCategory.name,
  categorySlug: parentCategory.slug,
  subcategoryName: subcategory.name,
  subcategorySlug: subcategory.slug,
});
---

<BaseLayout
  title={subcategory.seoTitle || `${subcategory.name} Buying Guides | DesiOffers Guides`}
  description={subcategory.seoDescription || subcategory.description}
  breadcrumbs={breadcrumbs}
>
  <div class="container subcategory-page-container">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Subcategory Header Card -->
    <header class="subcategory-header-card">
      <div class="header-badge-row">
        <a href={`/category/${parentCategory.slug}/`} class="category-eyebrow">{parentCategory.name}</a>
        <span class="guide-count-badge">{subcategoryArticles.length} Curated {subcategoryArticles.length === 1 ? 'Guide' : 'Guides'}</span>
      </div>
      <h1 class="subcategory-h1">{subcategory.name}</h1>
      <p class="subcategory-desc">{subcategory.description}</p>
    </header>

    <!-- 2-Column Layout (2/3 Feed + 1/3 Sidebar) -->
    <div class="subcategory-layout-grid">
      <main class="subcategory-feed-column">
        {subcategoryArticles.length > 0 ? (
          <div class="subcategory-articles-grid">
            {subcategoryArticles.map((article, idx) => {
              const auth = authorMap.get(article.data.author.id);
              return (
                <ArticleCard
                  title={article.data.title}
                  slug={article.slug}
                  description={article.data.description}
                  categoryName={parentCategory.name}
                  categorySlug={parentCategory.slug}
                  heroImage={article.data.heroImage}
                  heroImageAlt={article.data.heroImageAlt}
                  publishedDate={article.data.publishedDate}
                  readingTime={article.data.readingTime}
                  authorName={auth?.name}
                  featured={idx === 0}
                  layout={idx === 0 ? 'horizontal' : 'vertical'}
                />
              );
            })}
          </div>
        ) : (
          <div class="empty-subcategory-box">
            <span class="empty-icon">🔎</span>
            <h3>No Guides Found in {subcategory.name}</h3>
            <p>We are continuously researching new products. Explore all guides in the {parentCategory.name} department.</p>
            <a href={`/category/${parentCategory.slug}/`} class="btn btn-primary" style="margin-top: 1rem;">View {parentCategory.name} Department</a>
          </div>
        )}
      </main>

      <aside class="subcategory-sidebar-column">
        <div class="sidebar-card">
          <h3 class="sidebar-heading">{parentCategory.name} Department</h3>
          <p class="sidebar-text">
            Looking for broader buying advice? Explore our complete department guides and comparisons across {parentCategory.name}.
          </p>
          <a href={`/category/${parentCategory.slug}/`} class="sidebar-action-link">
            All {parentCategory.name} Guides →
          </a>
        </div>

        <div class="sidebar-card highlight-card">
          <h3 class="sidebar-heading">Join SmartFinds Community</h3>
          <p class="sidebar-text">
            Get instant alerts on price drops, lightning deals, and new buying guides directly in your feed.
          </p>
          <div class="channel-buttons">
            <a href="https://t.me/desioffers" target="_blank" rel="noopener" class="btn-channel telegram">
              <span>✈️ Telegram Alerts</span>
            </a>
            <a href="https://whatsapp.com/channel/desioffers" target="_blank" rel="noopener" class="btn-channel whatsapp">
              <span>💬 WhatsApp Channel</span>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .subcategory-page-container {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  /* Header Card */
  .subcategory-header-card {
    background: linear-gradient(135deg, var(--color-white) 0%, var(--color-primary-light) 100%);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    padding: 2.25rem 2.5rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-subtle);
  }
  .header-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .category-eyebrow {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--color-primary);
    background-color: var(--color-white);
    border: 1px solid var(--color-primary-border);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .category-eyebrow:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
  }
  .guide-count-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-slate-600);
  }
  .subcategory-h1 {
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: var(--color-slate-900);
    letter-spacing: -0.025em;
    margin-bottom: 0.6rem;
    line-height: 1.15;
  }
  .subcategory-desc {
    font-size: 1.05rem;
    color: var(--color-slate-600);
    line-height: 1.6;
    max-width: 780px;
    margin: 0;
  }

  /* 2-Column Grid */
  .subcategory-layout-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.25rem;
    align-items: start;
  }

  .subcategory-articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .empty-subcategory-box {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 4rem 2rem;
    text-align: center;
    box-shadow: var(--shadow-subtle);
  }
  .empty-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
  }
  .empty-subcategory-box h3 {
    font-size: 1.35rem;
    color: var(--color-slate-800);
    margin-bottom: 0.5rem;
  }
  .empty-subcategory-box p {
    color: var(--color-slate-600);
    font-size: 0.95rem;
    max-width: 480px;
    margin: 0 auto;
  }

  /* Sidebar */
  .subcategory-sidebar-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sidebar-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-subtle);
  }
  .sidebar-card.highlight-card {
    background: linear-gradient(135deg, var(--color-white) 0%, var(--color-primary-light) 100%);
    border-color: var(--color-primary-border);
  }
  .sidebar-heading {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-slate-900);
    margin-bottom: 0.65rem;
  }
  .sidebar-text {
    font-size: 0.88rem;
    color: var(--color-slate-600);
    line-height: 1.55;
    margin-bottom: 1rem;
  }
  .sidebar-action-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }
  .sidebar-action-link:hover {
    text-decoration: underline;
  }
  .channel-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .btn-channel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .btn-channel.telegram {
    background-color: #0088cc;
    color: #ffffff;
  }
  .btn-channel.telegram:hover {
    background-color: #0077b5;
  }
  .btn-channel.whatsapp {
    background-color: #25d366;
    color: #ffffff;
  }
  .btn-channel.whatsapp:hover {
    background-color: #20ba59;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .subcategory-layout-grid {
      grid-template-columns: 1fr;
    }
    .subcategory-sidebar-column {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  @media (max-width: 640px) {
    .subcategory-page-container {
      padding-top: 0.75rem;
      padding-bottom: 3rem;
    }
    .subcategory-header-card {
      padding: 1.5rem 1.25rem;
      margin-bottom: 1.25rem;
    }
    .subcategory-h1 {
      font-size: clamp(1.6rem, 5vw, 2.1rem);
    }
    .subcategory-desc {
      font-size: 0.95rem;
    }
    .subcategory-layout-grid {
      gap: 2rem;
    }
    .subcategory-articles-grid {
      grid-template-columns: 1fr;
    }
    .subcategory-sidebar-column {
      grid-template-columns: 1fr;
    }
    .sidebar-card {
      padding: 1.25rem 1rem;
    }
  }
</style>
